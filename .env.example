# ---------------------------------------------------------------------------
# general-laudos — exemplo de configuracao
#
# Copie este arquivo para `.env.local` (ou `.env`) e preencha os valores.
# NUNCA commite um arquivo .env com valores reais: o .gitignore bloqueia
# todos os `.env*` justamente por isso — este `.env.example` e a unica excecao.
# ---------------------------------------------------------------------------

# --- Ambiente ---------------------------------------------------------------
NODE_ENV=development

# --- URLs publicas ----------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Identidade e links externos da instalacao ------------------------------
# Nada disso e obrigatorio: sem valor, o bloco correspondente some da tela.
NEXT_PUBLIC_MAINTAINER_NAME=General Inspetor
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SIBLING_APP_NAME=General TMS
NEXT_PUBLIC_SIBLING_APP_URL=

# --- Banco de dados (Prisma) ------------------------------------------------
# SQLite local (padrao de desenvolvimento):
DATABASE_URL="file:./dev.db"
# PostgreSQL: DATABASE_URL="postgresql://USER:CHANGE_ME@HOST:5432/DBNAME"

# --- Autenticacao / sessao --------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME
# Salt do hash de senha legado (SHA-256). Obrigatorio: sem ele a verificacao
# de senhas antigas lanca erro — nao existe mais valor padrao no codigo.
AUTH_SALT=CHANGE_ME

# --- OpenAI (leitura de documentos / assistente) ----------------------------
OPENAI_API_KEY=CHANGE_ME
OPENAI_ASSISTANT_ID=CHANGE_ME

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=CHANGE_ME

# --- Telegram (notificacoes) ------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
TELEGRAM_TOPIC_ID=

# --- Upload de arquivos -----------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# --- Cookies / logging (producao) -------------------------------------------
SECURE_COOKIES=false
SAME_SITE_COOKIES=lax
LOG_LEVEL=info

# --- Deploy (opcional) ------------------------------------------------------
SERVER_IP=
DOMAIN=
